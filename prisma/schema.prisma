// This is your Prisma schema file
// Prisma v7 with PostgreSQL - Full v7 support enabled

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Connection URL is configured in prisma/config.ts for Prisma v7
}

// Guild settings
model Guild {
  id               String   @id @default(uuid())
  discordId        String   @unique
  name             String
  prefix           String?  @default("!")
  welcomeMessage   String?  @db.Text
  welcomeChannelId String?
  modLogChannelId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum DndTransactionType {
  DEPOSIT
  WITHDRAWAL
}

enum DndCurrency {
  CP
  SP
  GP
  EL
  PC
}

// D&D data is partitioned by Discord server. Each server has its own wallets,
// so a member's coins in one server are never visible to another server.
model DndServer {
  id                 String        @id @default(uuid())
  discordId          String        @unique
  name               String
  aiNarrationEnabled Boolean       @default(true)
  aiTemperature      Float         @default(1.0)
  aiMaxTokens        Int?
  aiReasoningEffort  String        @default("low")
  divineMeanness     Int           @default(2)
  campaigns          DndCampaign[]
  writingStyles      UserWritingStyle[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model UserWritingStyle {
  id            String    @id @default(uuid())
  serverId      String
  discordUserId String
  profile       Json      @default("{}")
  sampleCount   Int       @default(0)
  server        DndServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([serverId, discordUserId])
  @@index([serverId])
}

model UserMessageHistory {
  id            String              @id @default(uuid())
  guildId       String
  discordUserId String
  displayName   String
  avatarUrl     String
  messages      GuildMessageHistory[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([guildId, discordUserId])
  @@index([guildId])
}

model GuildMessageHistory {
  id                String            @id @default(uuid())
  historyId         String
  discordMessageId  String            @unique
  discordChannelId  String
  content           String            @db.Text
  createdAt         DateTime
  history           UserMessageHistory @relation(fields: [historyId], references: [id], onDelete: Cascade)

  @@index([historyId, createdAt])
}

model DndCampaign {
  id           String           @id @default(uuid())
  serverId     String
  name         String
  gameSystem   String           @default("D&D 5e")
  isDefault    Boolean          @default(false)
  server       DndServer        @relation(fields: [serverId], references: [id], onDelete: Cascade)
  wallets      DndWallet[]
  characters   DndCharacter[]
  storyTidbits DndStoryTidbit[]
  encounters   DndEncounter[]
  storyBigPicture String?      @db.Text
  storyBigPictureUpdatedAt DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([serverId, name])
  @@index([serverId])
}

model DndCharacter {
  id            String      @id @default(uuid())
  campaignId    String
  discordUserId String
  characterName String?
  sheetData     Json        @default("{}")
  memories      String      @default("") @db.Text
  campaign      DndCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([campaignId, discordUserId])
  @@index([campaignId])
}

model DndStoryTidbit {
  id            String      @id @default(uuid())
  campaignId    String
  discordUserId String
  kind          DndStoryKind @default(EVENT)
  content       String      @db.Text
  interpretation String?    @db.Text
  interpretedAt DateTime?
  campaign      DndCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@index([campaignId, createdAt])
}

enum DndStoryKind {
  EVENT
  NPC
  LOCATION
  CLUE
  QUEST
  LORE
}

model DndEncounter {
  id                    String      @id @default(uuid())
  campaignId            String
  title                 String
  scene                 String?     @db.Text
  round                 Int         @default(1)
  currentTurnIndex      Int         @default(-1)
  turnOrder             Json        @default("[]")
  revision              Int         @default(0)
  isActive              Boolean     @default(true)
  createdByDiscordUserId String
  campaign              DndCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdAt             DateTime    @default(now())
  endedAt               DateTime?

  @@index([campaignId, isActive, createdAt])
}

model DndWallet {
  id            String           @id @default(uuid())
  campaignId    String
  discordUserId String
  copperCp      BigInt           @default(0)
  silverSp      BigInt           @default(0)
  goldGp        BigInt           @default(0)
  electrumEl    BigInt           @default(0)
  platinumPc    BigInt           @default(0)
  campaign      DndCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  transactions  DndTransaction[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([campaignId, discordUserId])
  @@index([campaignId])
}

model DndTransaction {
  id                   String             @id @default(uuid())
  walletId             String
  discordInteractionId String
  type                 DndTransactionType
  amount                BigInt
  balanceAfter          BigInt
  currency              DndCurrency        @default(GP)
  narration            String?            @db.Text
  wallet               DndWallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  createdAt            DateTime           @default(now())

  @@index([walletId, createdAt])
  @@unique([discordInteractionId, currency])
}
