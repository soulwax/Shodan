// This is your Prisma schema file
// Prisma v7 with PostgreSQL - Full v7 support enabled

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Connection URL is configured in prisma/config.ts for Prisma v7
}

// User model to store user data
model User {
  id            String         @id @default(uuid())
  discordId     String         @unique
  username      String
  discriminator String?
  avatar        String?
  commands      Command[]
  tarotReadings TarotReading[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// Command model to track command usage
model Command {
  id        String   @id @default(uuid())
  name      String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  guildId   String?
  arguments Json?
  createdAt DateTime @default(now())
}

// Tarot reading model
model TarotReading {
  id             String   @id @default(uuid())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  cardName       String
  isReversed     Boolean
  question       String?
  interpretation String   @db.Text
  createdAt      DateTime @default(now())
  seed           String?

  @@index([userId])
  @@index([createdAt])
}

// Guild settings
model Guild {
  id               String   @id @default(uuid())
  discordId        String   @unique
  name             String
  prefix           String?  @default("!")
  welcomeMessage   String?  @db.Text
  welcomeChannelId String?
  modLogChannelId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum DndTransactionType {
  DEPOSIT
  WITHDRAWAL
}

// D&D data is partitioned by Discord server. Each server has its own wallets,
// so a member's gold in one server is never visible to another server.
model DndServer {
  id                 String        @id @default(uuid())
  discordId          String        @unique
  name               String
  aiNarrationEnabled Boolean       @default(true)
  campaigns          DndCampaign[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model DndCampaign {
  id           String           @id @default(uuid())
  serverId     String
  name         String
  gameSystem   String           @default("D&D 5e")
  isDefault    Boolean          @default(false)
  server       DndServer        @relation(fields: [serverId], references: [id], onDelete: Cascade)
  wallets      DndWallet[]
  characters   DndCharacter[]
  storyTidbits DndStoryTidbit[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([serverId, name])
  @@index([serverId])
}

model DndCharacter {
  id            String      @id @default(uuid())
  campaignId    String
  discordUserId String
  characterName String?
  sheetData     Json        @default("{}")
  memories      String      @default("") @db.Text
  campaign      DndCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([campaignId, discordUserId])
  @@index([campaignId])
}

model DndStoryTidbit {
  id            String      @id @default(uuid())
  campaignId    String
  discordUserId String
  content       String      @db.Text
  campaign      DndCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@index([campaignId, createdAt])
}

model DndWallet {
  id            String           @id @default(uuid())
  campaignId    String
  discordUserId String
  goldGp        BigInt           @default(0)
  campaign      DndCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  transactions  DndTransaction[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([campaignId, discordUserId])
  @@index([campaignId])
}

model DndTransaction {
  id                   String             @id @default(uuid())
  walletId             String
  discordInteractionId String             @unique
  type                 DndTransactionType
  amountGp             BigInt
  balanceAfterGp       BigInt
  narration            String?            @db.Text
  wallet               DndWallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  createdAt            DateTime           @default(now())

  @@index([walletId, createdAt])
}
