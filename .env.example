# Discord application
BOT_TOKEN=
CLIENT_ID=
LANGUAGE_CHANNEL_ID=

# PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# Optional direct connection for Prisma migrations (useful when DATABASE_URL is pooled)
DATABASE_URL_UNPOOLED=

# Optional AI providers; tried in this order: Gemini, OpenAI, Cloudflare Workers AI, Grok, Anthropic
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY= # or GROK_API_KEY
ANTHROPIC_API_KEY=
CF_TOKEN=
CF_ACCOUNT_ID=

# Per-provider AI API limit. Defaults to 10 requests/minute when omitted (max 60).
AI_REQUESTS_PER_MINUTE=10
