# Optional AI providers; tried in this order: OpenAI, Gemini, Grok, Anthropic
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY= # or GROK_API_KEY
ANTHROPIC_API_KEY=
